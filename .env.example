# ────────────────────────────────────────────────────────────────
# RaiKids POS — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit `.env` — it contains secrets (API keys, admin
# password). `.env` is in .gitignore. See README.md for details.
# ────────────────────────────────────────────────────────────────

# ── Database ──
# SQLite file lives next to the app by default.
DATABASE_URL=sqlite:///./referral.db

# ── Admin ──
# First-run admin password. After the first login you can (and
# should) change it from: Admin panel → Settings → "تغییر رمز عبور".
# If unset, admin login is disabled until you set it.
ADMIN_PASSWORD=change-me-please

# Session signing secret. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated on every start, which logs
# everyone out whenever the app restarts.
SESSION_SECRET=change-me-please

# Optional token protecting the /api/* endpoints (phone app photo
# upload / try-on). Generate one with the same command as above.
# If unset, /api/* requires an admin login session instead.
API_TOKEN=change-me-please

# ── SMS gateway (self-hosted) ──
SMS_GATEWAY_URL=http://185.214.101.206
SMS_API_KEY=change-me
SMS_DEVICE_ID=2

# ── Virtual try-on AI ──
TRYON_API_URL=https://api.gapgpt.app/v1/images/edits
TRYON_API_KEY=change-me
PUTER_TOKEN=
